{
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--all-scopes-completion",
        "--query-driver=**/.platformio/packages/toolchain-xtensa-esp-elf/bin/*"
    ],
    // Pylance - intellisense, completions, hover, type checking for scripts
    "python.defaultInterpreterPath": "${userHome}/.platformio/penv/bin/python",
    "python.languageServer": "Pylance",
    "python.terminal.activateEnvironment": false,
    // Ruff (Python linter) - uses penv binary
    "ruff.path": [
        "${userHome}/.platformio/penv/bin/ruff"
    ],
    "ruff.lineLength": 120,
    "ruff.lint.select": [
        "E",
        "F",
        "W"
    ],
    "ruff.lint.ignore": [
        "F821",
        "F405"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "platformio-ide.autoRebuildAutocompleteIndex": true
}