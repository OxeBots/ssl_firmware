{
  "name": "PlatformIO + AI",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "VARIANT": "bookworm",
      "USERNAME": "${localEnv:USER}",
      "FEDORA_COMPAT": "1",
      "TZ": "${localEnv:TZ:America/Sao_Paulo}",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0",
      // AI agents — set to "1" to install
      "INSTALL_CLAUDE": "0",
      "INSTALL_GEMINI": "0",
      "INSTALL_QWEN": "0",
      "INSTALL_CODEX": "0",
      "INSTALL_OPENCODE": "0",
      "INSTALL_PI": "0"
    }
  },
  "runArgs": [
    // Allow USB serial device access (FTDI/CH340 = major 188, CDC ACM = major 166)
    // Combined with udev rules in Dockerfile — replaces --privileged
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 166:* rmw",
    "--group-add=dialout"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "jeff-hykin.better-cpp-syntax",
        "nordic-semiconductor.nrf-kconfig",
        "alexnesnes.teleplot",
        "hit9.bitproto",
        "ms-python.python",
        "charliermarsh.ruff",
        "mhutchie.git-graph",
        "yzhang.markdown-all-in-one",
        "dnut.rewrap-revived",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },
        "editor.formatOnSave": true,
        "platformio-ide.pioHomeServerHttpPort": 8008
      }
    }
  },
  "mounts": [
    // Hardware access for PlatformIO
    "source=/dev/,target=/dev/,type=bind,consistency=consistent",
    // Persistent shell history (survives container rebuilds)
    "source=pio-bash-history-${devcontainerId},target=/home/${localEnv:USER}/.history,type=volume",
    // Persistent AI configs (survive container rebuilds)
    "source=pio-claude-config-${devcontainerId},target=/home/${localEnv:USER}/.claude,type=volume",
    "source=pio-gemini-config-${devcontainerId},target=/home/${localEnv:USER}/.gemini,type=volume",
    "source=pio-qwen-config-${devcontainerId},target=/home/${localEnv:USER}/.qwen,type=volume",
    "source=pio-codex-config-${devcontainerId},target=/home/${localEnv:USER}/.codex,type=volume",
    "source=pio-pi-config-${devcontainerId},target=/home/${localEnv:USER}/.pi,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/${localEnv:USER}/.claude",
    "GEMINI_CONFIG_DIR": "/home/${localEnv:USER}/.gemini",
    "QWEN_CONFIG_DIR": "/home/${localEnv:USER}/.qwen",
    "CODEX_CONFIG_DIR": "/home/${localEnv:USER}/.codex",
    "PI_CONFIG_DIR": "/home/${localEnv:USER}/.pi"
  },
  "forwardPorts": [
    8008
  ],
  "portsAttributes": {
    "8008": {
      "label": "PlatformIO Home",
      "onAutoForward": "notify"
    }
  },
  "postAttachCommand": "sudo udevadm control --reload 2>/dev/null || true",
  "features": {}
}