#
# GPIO limits
#
CONFIG_GPIO_MAX_INDEX=39

# Critical-fault lockout
CONFIG_DISABLE_SAFE_STOP=y

#
# I2C
#
CONFIG_SDA_GPIO=21
CONFIG_SCL_GPIO=22
CONFIG_I2C_PORT_NUM=0

#
# SPI
#
CONFIG_MISO_GPIO=19
CONFIG_MOSI_GPIO=23
CONFIG_SCLK_GPIO=18

#
# 74HC595 output shift register
#
# RCKSR latch
CONFIG_SHIFT_REGISTER_LATCH_GPIO=17
CONFIG_SHIFT_REGISTER_DEVICE_KEY=254
CONFIG_SHIFT_REGISTER_DIR1_BIT=0
CONFIG_SHIFT_REGISTER_DIR2_BIT=1
CONFIG_SHIFT_REGISTER_DIR3_BIT=2
CONFIG_SHIFT_REGISTER_DIR4_BIT=3
CONFIG_SHIFT_REGISTER_MUX_A_BIT=4
CONFIG_SHIFT_REGISTER_MUX_B_BIT=5
CONFIG_SHIFT_REGISTER_MUX_INH_BIT=6
# nRF24L01 CE input, driven through the register (CERF24 / output QH)
CONFIG_SHIFT_REGISTER_RF_CE_BIT=7

# Bound VL53L5CX I2C operations so a missing or unpowered module cannot block startup forever.
CONFIG_VL53L5CX_I2C_TIMEOUT=y
CONFIG_VL53L5CX_I2C_TIMEOUT_VALUE=1000

#
# Motor interfaces
#

# Front Left — M1
# ENCM1: GPIO36 / ADC1 Channel 0
CONFIG_MOTOR_FL_ENC_CHANNEL=0
CONFIG_MOTOR_FL_PWM_GPIO=32
CONFIG_MOTOR_FL_FB_GPIO=25

# Back Left — M2
# ENCM2: GPIO35 / ADC1 Channel 7
CONFIG_MOTOR_BL_ENC_CHANNEL=7
CONFIG_MOTOR_BL_PWM_GPIO=26
CONFIG_MOTOR_BL_FB_GPIO=27

# Back Right — M3
# ENCM3: GPIO34 / ADC1 Channel 6
CONFIG_MOTOR_BR_ENC_CHANNEL=6
CONFIG_MOTOR_BR_PWM_GPIO=14
CONFIG_MOTOR_BR_FB_GPIO=13

# Front Right — M4
# ENCM4: GPIO39 / ADC1 Channel 3
CONFIG_MOTOR_FR_ENC_CHANNEL=3
CONFIG_MOTOR_FR_PWM_GPIO=12
# FBM4: GPIO2
CONFIG_MOTOR_FR_FB_GPIO=2

#
# Supply-voltage monitoring
#
# VMON: GPIO33 / ADC1 Channel 5
CONFIG_VMON_ADC_CHANNEL=5
# Divider: 56k series + 2k2 shunt, ratio = (56 + 2.2) / 2.2 = 26.4545
CONFIG_VMON_SUPPLY_RATIO_MILLI=26455
# 6S2P 18650 lithium ion pack: 25.2 V full, 19.8 V low (3.3 V/cell)
CONFIG_VMON_UNDERVOLTAGE_MV=19800
CONFIG_VMON_OVERVOLTAGE_MV=26500
# Aggregate conversions per second shared by the scan table slots. OVERSAMPLE
# 16 doubles the publication rate to ~2.3 kHz per wheel; the hot path was
# optimized (incremental least-squares sums, decimated FG queries, acquisition
# task pinned to core 1) so the dispatch task keeps up without starving the
# boot/init tasks.
CONFIG_ADC_SAMPLE_FREQ_HZ=160000
# Block mean of N conversions per sampled channel
CONFIG_ADC_OVERSAMPLE=12

#
# Control loop rate
#
# The wheel control task runs at the FreeRTOS tick (1 ms) so the low-speed
# pulse/velocity loop can commutate fast enough for the ripple requirement.
CONFIG_FREERTOS_HZ=1000

#
# GY-85 interrupts
#
# Accelerometer INT1
CONFIG_GY85_AINT1_GPIO=5
# Gyroscope interrupt
CONFIG_GY85_GINT_GPIO=15
# Magnetometer data-ready
CONFIG_GY85_MDRDY_GPIO=16

#
# VL53L5CX Time-of-Flight sensor
#
CONFIG_TOF_INT_GPIO=1

#
# Serial debug dashboard
#
# Streams binary debug frames over UART0 while a dashboard client keeps the
# connection alive (see proto/serial_debug_protocol.bitproto).
CONFIG_SERIAL_DEBUG=y

#
# nRF24L01 configuration
#
CONFIG_GPIO_RANGE_MAX=39
CONFIG_RADIO_CHANNEL=76

CONFIG_CSN_GPIO=0
CONFIG_IRQ_GPIO=4
# Software key for the shared SPI driver (manual chip-select, not a GPIO)
CONFIG_NRF24_SPI_DEVICE_KEY=253

CONFIG_SPI2_HOST=y
# CONFIG_SPI3_HOST is not set

#
# Encoder acquisition performance
#
# -O2 and 240 MHz for the ADC dispatch/EKF hot path, with assertions kept enabled.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ADVANCED=y
CONFIG_RF_RATIO_2M=y
# CONFIG_RF_RATIO_1M is not set
# CONFIG_RF_RATIO_250K is not set

CONFIG_RETRANSMIT_DELAY=2
CONFIG_RETRANSMIT_COUNT=15
